      tokens TEXT NOT NULL -- JSON string of tokens
    );
CREATE TABLE IF NOT EXISTS themecustomization (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      preset_id INTEGER REFERENCES themepreset(id),
      custom_tokens TEXT NOT NULL,
